# Optional, non-secret local demo overrides. Compose also has safe defaults.
# Do not reuse these demo-only database credentials outside this local stack.
DEMO_MYSQL_ROOT_PASSWORD=mordisco-demo-root
DEMO_DB_PASSWORD=mordisco-demo-pass
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:4200
HTTP_ALLOWED_ORIGINS=http://localhost:4200

# By default, ./start.sh generates a fresh 32-byte JWT_SECRET for each start.
# It is not written to this file, but Compose passes it to the backend container environment.
# A fresh key invalidates existing sessions. Direct Compose startup needs JWT_SECRET
# (at least 32 characters) in your shell environment or this .env file.

# Optional integrations. Use only your own Mercado Pago test credentials.
# Never put real payment credentials or production keys in the demo stack.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_NOTIFICATION_URL=http://localhost:8080/api/pagos/webhook

# Optional configuration reference only; the app does not currently use weather.
# OPENWEATHERMAP_API_KEY=
