# Production variable names and safe placeholders only.
# Copy these names into Vercel Project Settings. Never store real values here.

# Normal production startup: keep the demo seed disabled.
SPRING_PROFILES_ACTIVE=prod
# Temporary preview seed activation: use for one start/redeploy only, then restore prod.
# SPRING_PROFILES_ACTIVE=prod,schema-bootstrap,demo-seed
DATABASE_URL=jdbc:mysql://<tidb-host>:<tidb-port>/<database>?sslMode=VERIFY_IDENTITY
DATABASE_USERNAME=<tidb-application-user>
DATABASE_PASSWORD=<tidb-password>
FRONTEND_URL=https://<vercel-domain>
WEBSOCKET_ALLOWED_ORIGINS=https://<vercel-domain>
JWT_SECRET=<random-secret-at-least-32-characters>

SPRING_MAIL_HOST=<smtp-host>
SPRING_MAIL_PORT=<smtp-starttls-port>
SPRING_MAIL_USERNAME=<smtp-username>
SPRING_MAIL_PASSWORD=<smtp-password>
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

OPENWEATHERMAP_API_KEY=<weather-provider-api-key>

MERCADOPAGO_ACCESS_TOKEN=<sandbox-access-token>
MERCADOPAGO_PUBLIC_KEY=<sandbox-public-key>
MERCADOPAGO_WEBHOOK_SECRET=<sandbox-webhook-signature-secret>
MERCADOPAGO_NOTIFICATION_URL=https://<vercel-domain>/api/pagos/webhook
MERCADOPAGO_ENVIRONMENT=sandbox

MAINTENANCE_SECRET=<random-maintenance-secret>

DB_POOL_MIN_IDLE=0
DB_POOL_MAX_SIZE=4
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_POOL_VALIDATION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_POOL_MAX_LIFETIME_MS=300000

PASSWORD_RECOVERY_EXPIRATION_SECONDS=3600
PASSWORD_RECOVERY_COOLDOWN_SECONDS=300
