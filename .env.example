# Database
DATABASE_URL=jdbc:mysql://mysql:3306/mordisco?createDatabaseIfNotExist=true
DATABASE_USERNAME=mordisco
DATABASE_PASSWORD=CHANGE_ME_LOCAL_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=mordisco
MYSQL_USER=mordisco
MYSQL_PASSWORD=CHANGE_ME_LOCAL_MYSQL_PASSWORD
TZ=UTC

# Backend
SERVER_PORT=8080
FRONTEND_URL=http://localhost:4200
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:4200
SPRING_MAIL_HOST=CHANGE_ME_LOCAL_SMTP_HOST
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=CHANGE_ME_LOCAL_SMTP_USERNAME
SPRING_MAIL_PASSWORD=CHANGE_ME_LOCAL_SMTP_PASSWORD
OPENWEATHERMAP_API_KEY=CHANGE_ME_LOCAL_OPENWEATHERMAP_API_KEY
JWT_SECRET=LOCAL_ONLY_JWT_SECRET_REPLACE_WITH_A_STRONG_RANDOM_VALUE_BEFORE_USE_1234567890
MERCADOPAGO_ACCESS_TOKEN=CHANGE_ME_LOCAL_MERCADOPAGO_ACCESS_TOKEN
MERCADOPAGO_PUBLIC_KEY=CHANGE_ME_LOCAL_MERCADOPAGO_PUBLIC_KEY

# Optional production profile TLS
SSL_KEYSTORE=classpath:synthetic-local-keystore.p12
SSL_KEYSTORE_PASSWORD=CHANGE_ME_LOCAL_SSL_KEYSTORE_PASSWORD
